{% capture children %}
  <div class="grip-faq" style="--grip-faq-sticky: {{ section.settings.sticky_offset }}px;">
    <div class="grip-faq__aside">
      {%- if section.settings.label != blank -%}
        <p class="grip-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="grip-display h1 grip-faq__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- render 'grip-button',
        label: section.settings.button_label,
        link: section.settings.button_link,
        style: section.settings.button_style,
        arrow: section.settings.button_arrow
      -%}
    </div>

    <div class="grip-faq__list">
      {%- if section.blocks.size > 0 -%}
        {% content_for 'blocks' %}
      {%- elsif request.design_mode -%}
        <p class="grip-editor-note">FAQ: add an accordion block.</p>
      {%- endif -%}
    </div>
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children %}

{% stylesheet %}
  .grip-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--grip-gap-xl);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 38fr) minmax(0, 62fr);
      align-items: start;
      gap: clamp(3rem, 5vw, 6rem);
    }
  }

  .grip-faq__aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    align-content: start;
    gap: 1.25rem;

    & .grip-actions {
      margin-block-start: 0.75rem;
    }

    @media screen and (min-width: 990px) {
      position: sticky;
      inset-block-start: calc(var(--header-height, 0px) + var(--grip-faq-sticky, 32px));
    }
  }

  .grip-faq__heading.grip-faq__heading.grip-faq__heading {
  
    font-size: clamp(3rem, 6vw, 5.25rem);
    line-height: 0.9;
  }

  .grip-faq__list {
    min-width: 0;
  }

  /* Horizon accordion restyled to plain question rows */
  .grip-faq .accordion {
    border-block-start: 1px solid var(--color-border);
  }

  .grip-faq .accordion .details__header {
    padding-block: 1.125rem;
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
  }

  .grip-faq .accordion .details__header:hover {
    color: var(--grip-accent);
  }

  .grip-faq .accordion .details-content {
    max-width: 60ch;
    color: var(--grip-muted, var(--grip-muted-default));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP FAQ",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "accordion" }],
  "max_blocks": 1,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "FREQUENTLY ASKED QUESTIONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "REAL QUESTIONS. STRAIGHT ANSWERS." },
    { "type": "range", "id": "sticky_offset", "label": "Sticky heading offset (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SEE ALL FAQS" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The button is hidden until a link is set." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#070A10" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8B95A6" },
    { "type": "color", "id": "hairline_color", "label": "Hairlines", "default": "#3B4452" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "presets": [
    {
      "name": "GRIP FAQ",
      "category": "GRIP",
      "blocks": {
        "faq": {
          "type": "accordion",
          "settings": { "icon": "plus", "dividers": true, "divider_color": "#3B4452", "type_preset": "paragraph" },
          "blocks": {
            "use": {
              "type": "_accordion-row",
              "settings": { "heading": "How do I use the stick pack?" },
              "blocks": { "answer": { "type": "text", "settings": { "text": "<p>Mix 1 stick pack with 16–20 oz of cold water. Shake or stir thoroughly before, during, or after training.</p>", "type_preset": "rte", "width": "100%" } } },
              "block_order": ["answer"]
            },
            "shelf_life": {
              "type": "_accordion-row",
              "settings": { "heading": "What is the shelf life?" },
              "blocks": { "answer": { "type": "text", "settings": { "text": "<p>Our stick packs have a shelf life of 2 years from the manufacturing date.</p>", "type_preset": "rte", "width": "100%" } } },
              "block_order": ["answer"]
            },
            "international": {
              "type": "_accordion-row",
              "settings": { "heading": "Do you ship internationally?" },
              "blocks": { "answer": { "type": "text", "settings": { "text": "<p>We currently ship across the United States. International shipping options will roll out soon.</p>", "type_preset": "rte", "width": "100%" } } },
              "block_order": ["answer"]
            },
            "payment": {
              "type": "_accordion-row",
              "settings": { "heading": "What payment methods do you accept?" },
              "blocks": { "answer": { "type": "text", "settings": { "text": "<p>We accept all major credit cards, Apple Pay, Google Pay, and Shop Pay.</p>", "type_preset": "rte", "width": "100%" } } },
              "block_order": ["answer"]
            },
            "returns": {
              "type": "_accordion-row",
              "settings": { "heading": "Can I return my order?" },
              "blocks": { "answer": { "type": "text", "settings": { "text": "<p>Nothing has shipped yet \u2014 Blue Belt arrives in December. Full returns and refund details will be published before the first orders go out. If you have a question in the meantime, <a href=\"/pages/contact\">get in touch</a>.</p>", "type_preset": "rte", "width": "100%" } } },
              "block_order": ["answer"]
            }
          },
          "block_order": ["use", "shelf_life", "international", "payment", "returns"]
        }
      },
      "block_order": ["faq"]
    }
  ]
}
{% endschema %}
