{%- liquid
  assign channel_count = section.blocks | where: 'type', '_grip-contact-channel' | size
-%}

{% capture children %}
  <div
    class="grip-contact-main grip-contact-main--form-{{ section.settings.form_position }}"
    style="--grip-panel-bg: {{ section.settings.panel_color }};"
  >
    <div class="grip-contact-main__info">
      {%- if section.settings.label != blank or section.settings.heading != blank or section.settings.text != blank -%}
        <header class="grip-contact-main__header">
          {%- if section.settings.label != blank -%}
            <p class="grip-label grip-label--muted">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="grip-display h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="grip-contact-main__text grip-muted">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if channel_count > 0 -%}
        <ul class="grip-contact-main__channels" role="list">
          {% content_for 'blocks' %}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="grip-editor-note">Contact details: add channel blocks.</p>
      {%- endif -%}

      {% render 'grip-about-actions',
        primary_label: section.settings.button_label,
        primary_link: section.settings.button_link,
        secondary_label: section.settings.button_2_label,
        secondary_link: section.settings.button_2_link,
        arrow: true
      %}
    </div>

    <div class="grip-contact-main__panel">
      {%- if section.settings.form_label != blank or section.settings.form_heading != blank or section.settings.form_text != blank -%}
        <div class="grip-contact-main__panel-header">
          {%- if section.settings.form_label != blank -%}
            <p class="grip-label grip-label--muted">{{ section.settings.form_label | escape }}</p>
          {%- endif -%}
          {%- if section.settings.form_heading != blank -%}
            <h2 class="grip-display h3">{{ section.settings.form_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.form_text != blank -%}
            <p class="grip-contact-main__form-text grip-muted">{{ section.settings.form_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% content_for 'block', type: 'contact-form', id: 'contact-form' %}
    </div>
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children %}

{% stylesheet %}
  .grip-contact-main {
    display: grid;
    gap: var(--grip-gap-2xl);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
  }

  .grip-contact-main--form-left {
    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);

      & .grip-contact-main__panel {
        order: -1;
      }
    }
  }

  .grip-contact-main__info {
    display: grid;
    align-content: start;
    gap: var(--grip-gap-lg);
    min-width: 0;
  }

  .grip-contact-main__header,
  .grip-contact-main__panel-header {
    display: grid;
    gap: 1rem;
  }

  .grip-contact-main__text,
  .grip-contact-main__form-text {
    max-width: 32rem;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .grip-contact-main__channels {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-border);
  }

  .grip-contact-channel {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--color-border);
  }

  .grip-contact-channel--no-icon {
    grid-template-columns: minmax(0, 1fr);
  }

  .grip-contact-channel__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--grip-accent);
    border: 1px solid var(--color-border);
    border-radius: var(--grip-radius);
  }

  .grip-contact-channel__text {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .grip-contact-channel__value {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  a.grip-contact-channel__value {
    justify-self: start;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--animation-speed-medium, 0.15s) var(--animation-timing-hover, ease),
      text-decoration-color var(--animation-speed-medium, 0.15s) var(--animation-timing-hover, ease);

    &:hover {
      color: var(--grip-accent);
      text-decoration-color: currentColor;
    }
  }

  .grip-contact-channel__note {
    margin: 0;
    font-size: 0.9375rem;
  }

  .grip-contact-main__panel {
    display: grid;
    gap: var(--grip-gap-md);
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 3.5rem);
    background: var(--grip-panel-bg, var(--grip-s2));
    border: 1px solid var(--color-border);
    border-radius: var(--grip-radius);

    & .contact-form {
      width: 100%;
    }

    & .contact-form__input::placeholder {
      color: var(--grip-muted, var(--grip-muted-default));
      opacity: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP contact form",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_grip-contact-channel" }],
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "label", "label": "Label", "default": "REACH US" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "STRAIGHT TO THE TEAM." },
    { "type": "text", "id": "text", "label": "Text", "default": "For order questions, include your order number so we can help faster." },
    { "type": "header", "content": "Form panel" },
    { "type": "text", "id": "form_label", "label": "Label", "default": "SEND A MESSAGE" },
    { "type": "text", "id": "form_heading", "label": "Heading", "default": "WRITE TO US." },
    { "type": "text", "id": "form_text", "label": "Text", "default": "Tell us what you need and how to reach you." },
    {
      "type": "select",
      "id": "form_position",
      "label": "Form position on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color", "id": "panel_color", "label": "Panel background", "default": "#111823" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button label" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#05070A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8B95A6" },
    { "type": "color", "id": "hairline_color", "label": "Hairlines", "default": "#1D2634" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "presets": [
    {
      "name": "GRIP contact form",
      "category": "GRIP",
      "blocks": {
        "contact-form": {
          "type": "contact-form",
          "static": true,
          "settings": {
            "width": "custom",
            "custom_width": 100,
            "width_mobile": "custom",
            "custom_width_mobile": 100,
            "input_style": "custom",
            "input_background_color": "#0A0E15",
            "input_text_color": "#F2F4F7",
            "input_border_color": "#3B4452",
            "border_width": 1,
            "border_radius": 4
          },
          "blocks": {
            "submit-button": {
              "type": "contact-form-submit-button",
              "static": true,
              "settings": { "label": "SEND MESSAGE", "style_class": "button", "width": "fit-content", "width_mobile": "custom", "custom_width_mobile": 100 }
            }
          }
        },
        "email": { "type": "_grip-contact-channel", "settings": { "kind": "email", "label": "EMAIL", "note": "Orders and general questions" } },
        "location": { "type": "_grip-contact-channel", "settings": { "kind": "location", "label": "BASED IN", "value": "Edinburg, Texas" } }
      },
      "block_order": ["email", "location"]
    }
  ]
}
{% endschema %}
