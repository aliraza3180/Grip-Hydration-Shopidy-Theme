{% capture children %}
  <div
    class="grip-contact-faq"
    {% if section.settings.anchor != blank %}
      id="{{ section.settings.anchor | handleize }}"
    {% endif %}
  >
    {%- if section.settings.label != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <header class="grip-contact-faq__header">
        {%- if section.settings.label != blank -%}
          <p class="grip-label grip-label--muted">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="grip-display h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="grip-contact-faq__text grip-muted">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {% render 'grip-about-actions',
          primary_label: section.settings.button_label,
          primary_link: section.settings.button_link,
          secondary_label: section.settings.button_2_label,
          secondary_link: section.settings.button_2_link,
          arrow: true
        %}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="grip-contact-faq__list">
        {% content_for 'blocks' %}
      </div>
    {%- elsif request.design_mode -%}
      <p class="grip-editor-note">Questions: add question blocks.</p>
    {%- endif -%}
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children %}

{% stylesheet %}
  .grip-contact-faq {
    display: grid;
    gap: var(--grip-gap-xl);
    scroll-margin-top: calc(var(--header-group-height, 0px) + 2rem);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
  }

  .grip-contact-faq__header {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;

    @media screen and (min-width: 990px) {
      position: sticky;
      top: calc(var(--header-group-height, 0px) + 2rem);
    }

    & .grip-actions {
      margin-block-start: 0.5rem;
    }
  }

  .grip-contact-faq__text {
    max-width: 30rem;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .grip-contact-faq__list {
    min-width: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .grip-contact-q {
    border-block-end: 1px solid var(--color-border);
  }

  .grip-contact-q__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding-block: 1rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
    transition: color var(--animation-speed-medium, 0.15s) var(--animation-timing-hover, ease);

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: var(--grip-accent);
    }
  }

  .grip-contact-q__icon {
    display: inline-flex;
    flex-shrink: 0;
    transition: transform var(--animation-speed-medium, 0.15s) var(--animation-timing-hover, ease);
  }

  .grip-contact-q[open] .grip-contact-q__icon {
    transform: rotate(45deg);
  }

  .grip-contact-q__answer {
    display: grid;
    gap: 0.75rem;
    max-width: 60ch;
    padding-block-end: 1.5rem;
    line-height: 1.6;

    & p {
      margin: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP contact questions",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_grip-contact-question" }],
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "anchor", "label": "Section ID", "info": "Optional. GRIP FAQ links jump to the section with this ID, for example: orders" },
    { "type": "text", "id": "label", "label": "Label", "default": "BEFORE YOU WRITE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "QUICK ANSWERS." },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button label" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label", "default": "SEE ALL FAQS" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0A0E15" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8B95A6" },
    { "type": "color", "id": "hairline_color", "label": "Hairlines", "default": "#1D2634" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "presets": [
    {
      "name": "GRIP contact questions",
      "category": "GRIP",
      "blocks": {
        "q1": { "type": "_grip-contact-question", "settings": { "question": "Where is my order?", "answer": "<p>Your shipping confirmation email has a tracking link. If your order hasn't arrived or tracking hasn't updated, send us a message with your order number.</p>", "open": true } },
        "q2": { "type": "_grip-contact-question", "settings": { "question": "When do the other belts launch?", "answer": "<p>Blue Belt is available now. White, Purple, Brown and Black are coming soon, and our email list hears about new belts first.</p>" } }
      },
      "block_order": ["q1", "q2"]
    }
  ]
}
{% endschema %}
