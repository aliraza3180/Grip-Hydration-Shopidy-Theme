{%- liquid
  assign overlay = section.settings.overlay_color
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0

  assign has_image = false
  if section.settings.image_desktop != blank or section.settings.image_mobile != blank
    assign has_image = true
  endif

  assign stage_count = section.blocks.size
  assign last_live = 0
  for stage in section.blocks
    if stage.settings.status == 'live'
      assign last_live = forloop.index
    endif
  endfor

  assign progress = 0
  if stage_count > 0 and last_live > 0
    assign progress = last_live | minus: 0.5 | times: 100.0 | divided_by: stage_count
  endif

  capture roadmap_style
    echo '--grip-overlay-rgb: ' | append: overlay.red | append: ' ' | append: overlay.green | append: ' ' | append: overlay.blue | append: ';'
    echo '--grip-overlay-a: ' | append: overlay_alpha | append: ';'
    echo '--grip-roadmap-h: ' | append: section.settings.min_height | append: 'px;'
    echo '--grip-roadmap-progress: ' | append: progress | append: '%;'
  endcapture
-%}

{% capture children %}
  <div
    class="grip-roadmap{% if section.settings.grayscale %} grip-roadmap--grayscale{% endif %}"
    style="{{ roadmap_style | strip_newlines }}"
  >
    <div class="grip-roadmap__media">
      {%- if has_image -%}
        {% render 'grip-image',
          desktop: section.settings.image_desktop,
          mobile: section.settings.image_mobile,
          widths: '832, 1200, 1600, 1920, 2560',
          decorative: true
        %}
      {%- elsif request.design_mode -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'grip-placeholder' }}
      {%- endif -%}
    </div>
    <div class="grip-roadmap__scrim" aria-hidden="true"></div>

    <div class="grip-page-grid grip-roadmap__content">
      <div class="grip-roadmap__inner">
        <header class="grip-roadmap__intro">
          {%- if section.settings.label != blank -%}
            <p class="grip-label">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="grip-display h1 grip-roadmap__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="grip-roadmap__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- render 'grip-button',
            label: section.settings.button_label,
            link: section.settings.button_link,
            style: section.settings.button_style,
            arrow: section.settings.button_arrow
          -%}
        </header>

        {%- if section.blocks.size > 0 -%}
          <ol class="grip-roadmap__timeline" role="list" style="--grip-stage-count: {{ stage_count }};">
            {% content_for 'blocks' %}
          </ol>
        {%- elsif request.design_mode -%}
          <p class="grip-editor-note">Roadmap: add stage blocks.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children, width: 'full' %}

{% stylesheet %}
  .grip-roadmap {
    position: relative;
    display: grid;
    align-items: center;
    min-height: var(--grip-roadmap-h, 780px);
    isolation: isolate;
    overflow: hidden;

    @media screen and (max-width: 749px) {
      align-items: end;
      min-height: 0;
    }
  }

  .grip-roadmap__media,
  .grip-roadmap__scrim {
    position: absolute;
    inset: 0;
  }

  .grip-roadmap__media {
    z-index: -2;
  }

  .grip-roadmap--grayscale .grip-roadmap__media img {
    filter: grayscale(1);
  }

  .grip-roadmap__scrim {
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgb(var(--grip-overlay-rgb) / var(--grip-overlay-a)) 0%,
        rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.55)) 45%,
        rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.25)) 100%
      ),
      linear-gradient(0deg, rgb(var(--grip-overlay-rgb) / var(--grip-overlay-a)) 0%, rgb(var(--grip-overlay-rgb) / 0) 45%);

    @media screen and (max-width: 749px) {
      background: linear-gradient(
        0deg,
        rgb(var(--grip-overlay-rgb) / var(--grip-overlay-a)) 0%,
        rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.75)) 55%,
        rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.25)) 100%
      );
    }
  }

  .grip-roadmap__content {
    padding-block: var(--grip-gap-2xl);

    @media screen and (max-width: 749px) {
      padding-block-start: 10svh;
    }
  }

  .grip-roadmap__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 1.25rem;
    max-width: 36rem;
    margin-block-end: clamp(3rem, 6vw, 4.5rem);

    & .grip-actions {
      margin-block-start: 0.25rem;
    }
  }

  .grip-roadmap__heading.grip-roadmap__heading.grip-roadmap__heading {
  
    font-size: clamp(3rem, 6.4vw, 5.75rem);
    line-height: 0.92;
  }

  .grip-roadmap__sub {
    max-width: 24rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .grip-roadmap__timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--grip-stage-count, 4), minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: grip-stage;

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset-block-start: 1rem;
      inset-inline-start: 1rem;
    }

    &::before {
      inset-inline-end: 1rem;
      height: 1px;
      background: rgb(var(--color-foreground-rgb) / 0.3);
    }

    &::after {
      width: var(--grip-roadmap-progress, 0%);
      height: 2px;
      margin-block-start: -0.5px;
      background: var(--grip-accent);
    }

    @media screen and (max-width: 749px) {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;

      &::before {
        inset-block-end: 1rem;
        inset-inline-end: auto;
        width: 1px;
        height: auto;
      }

      &::after {
        width: 2px;
        height: var(--grip-roadmap-progress, 0%);
        margin-block-start: 0;
        margin-inline-start: -0.5px;
      }
    }
  }

  .grip-stage {
    position: relative;
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding-block-start: 3.5rem;
    counter-increment: grip-stage;

    @media screen and (max-width: 749px) {
      padding: 0.25rem 0 0 3.25rem;
    }
  }

  .grip-stage__num {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: var(--color-background);
    border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.55);
    border-radius: 50%;

    &::before {
      content: counter(grip-stage);
    }
  }

  .grip-stage--live .grip-stage__num {
    border: 2px solid var(--grip-accent);
  }

  .grip-stage__name {
    margin-block-end: 0.25rem;
  }

  .grip-stage__line {
    margin: 0;
    font-size: 0.875rem;
    color: var(--grip-muted, var(--grip-muted-default));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP roadmap",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "grip-stage" }],
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "Wide image with the subject on the right." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "4:5 recommended. Shown below 750px." },
    { "type": "checkbox", "id": "grayscale", "label": "Black and white", "default": false },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#05070A" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "range", "id": "min_height", "label": "Desktop height", "min": 480, "max": 1000, "step": 20, "unit": "px", "default": 780 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "label", "label": "Label", "default": "THE ROADMAP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A HIGHER STANDARD AHEAD." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A focused roadmap. Made for the mats. Built for what's next." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SEE THE BELT SYSTEM" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The button is hidden until a link is set." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#05070A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#C9D0DA" },
    { "type": "color", "id": "hairline_color", "label": "Hairlines", "default": "#1D2634" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "GRIP roadmap",
      "category": "GRIP",
      "blocks": {
        "blue": { "type": "grip-stage", "settings": { "name": "BLUE BELT", "status": "live", "line_1": "Launch", "line_2": "Now" } },
        "purple": { "type": "grip-stage", "settings": { "name": "PURPLE BELT", "status": "in_development", "line_1": "Coming Soon", "line_2": "Next" } },
        "brown": { "type": "grip-stage", "settings": { "name": "BROWN BELT", "status": "in_development", "line_1": "Coming Soon", "line_2": "Later" } },
        "black": { "type": "grip-stage", "settings": { "name": "BLACK BELT", "status": "in_development", "line_1": "Coming Soon", "line_2": "Beyond" } }
      },
      "block_order": ["blue", "purple", "brown", "black"]
    }
  ]
}
{% endschema %}
