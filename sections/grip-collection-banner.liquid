{%- liquid
  assign image_desktop = section.settings.image_desktop
  assign image_mobile = section.settings.image_mobile
  if image_desktop == blank and image_mobile == blank and section.settings.use_collection_image
    assign image_desktop = collection.featured_image
  endif

  assign has_image = false
  if image_desktop != blank or image_mobile != blank
    assign has_image = true
  endif

  assign heading = section.settings.heading | default: collection.title
  assign description = blank
  if section.settings.show_description
    assign description = collection.description
  endif

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign overlay = section.settings.overlay_color
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0

  capture banner_style
    echo '--grip-overlay-rgb: ' | append: overlay.red | append: ' ' | append: overlay.green | append: ' ' | append: overlay.blue | append: ';'
    echo '--grip-overlay-a: ' | append: overlay_alpha | append: ';'
    echo '--grip-banner-h: ' | append: section.settings.height_desktop | append: 'px;'
    echo '--grip-banner-h-m: ' | append: section.settings.height_mobile | append: 'px;'
  endcapture
-%}

{% capture children %}
  <div
    class="grip-banner grip-banner--{{ section.settings.alignment }}{% if section.settings.grayscale %} grip-banner--grayscale{% endif %}"
    style="{{ banner_style | strip_newlines }}"
  >
    <div class="grip-banner__media">
      {%- if has_image -%}
        {% render 'grip-image',
          desktop: image_desktop,
          mobile: image_mobile,
          widths: '832, 1200, 1600, 1920, 2560',
          loading: image_loading,
          fetchpriority: image_priority,
          decorative: true
        %}
      {%- elsif request.design_mode -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'grip-placeholder' }}
      {%- endif -%}
    </div>
    <div class="grip-banner__scrim" aria-hidden="true"></div>

    <div class="grip-page-grid grip-banner__content">
      <div class="grip-banner__stack">
        {%- if section.settings.label != blank -%}
          <p class="grip-label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h1 class="grip-display h1 grip-banner__heading">{{ heading | escape }}</h1>
        {%- endif -%}
        {%- if description != blank -%}
          <div class="rte grip-banner__text">{{ description }}</div>
        {%- endif -%}
        {%- render 'grip-button',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style: section.settings.button_style,
          arrow: section.settings.button_arrow
        -%}
      </div>
    </div>
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children, width: 'full' %}

{% stylesheet %}
  .grip-banner {
    position: relative;
    display: grid;
    align-items: end;
    min-height: var(--grip-banner-h, 440px);
    isolation: isolate;
    overflow: hidden;

    @media screen and (max-width: 749px) {
      min-height: var(--grip-banner-h-m, 420px);
    }
  }

  .grip-banner__media,
  .grip-banner__scrim {
    position: absolute;
    inset: 0;
  }

  .grip-banner__media {
    z-index: -2;
  }

  .grip-banner--grayscale .grip-banner__media img {
    filter: grayscale(1);
  }

  .grip-banner__scrim {
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(var(--grip-overlay-rgb) / var(--grip-overlay-a)) 0%,
      rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.5)) 50%,
      rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.15)) 100%
    );

    @media screen and (max-width: 749px) {
      background: linear-gradient(
        0deg,
        rgb(var(--grip-overlay-rgb) / var(--grip-overlay-a)) 0%,
        rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.55)) 55%,
        rgb(var(--grip-overlay-rgb) / 0.1) 100%
      );
    }
  }

  .grip-banner--center .grip-banner__scrim {
    background: rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.7));
  }

  .grip-banner__content {
    padding-block: var(--grip-gap-2xl);

    @media screen and (max-width: 749px) {
      padding-block: var(--grip-gap-xl);
    }
  }

  .grip-banner__stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 1rem;
    max-width: 44rem;

    & .grip-label,
    & .grip-actions {
      margin: 0;
    }

    & .grip-actions {
      margin-block-start: 0.5rem;
    }
  }

  .grip-banner--center .grip-banner__stack {
    justify-items: center;
    justify-self: center;
    text-align: center;
  }

  .grip-banner__heading.grip-banner__heading.grip-banner__heading {
    margin: 0;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6rem);
    line-height: 0.9;
    text-wrap: balance;
  }

  .grip-banner__text {
    max-width: 38rem;
    color: rgb(var(--color-foreground-rgb) / 0.85);

    & > :first-child {
      margin-block-start: 0;
    }

    & > :last-child {
      margin-block-end: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP collection banner",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "Wide image, 2560 × 1097 recommended. Keep the subject on the right." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "4:5, 1600 × 2000 recommended. Shown below 750px." },
    { "type": "checkbox", "id": "use_collection_image", "label": "Use the collection image when no image is set", "default": true },
    { "type": "checkbox", "id": "grayscale", "label": "Black and white", "default": false },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#05070A" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "label", "label": "Label", "default": "SHOP GRIP" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title." },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The button is hidden until a link is set." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 280, "max": 760, "step": 20, "unit": "px", "default": 440 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 240, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#05070A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "GRIP collection banner",
      "category": "GRIP"
    }
  ]
}
{% endschema %}
