{%- liquid
  assign has_image = false
  if section.settings.image != blank or section.settings.image_mobile != blank
    assign has_image = true
  endif

  assign show_media = has_image
  if request.design_mode
    assign show_media = true
  endif
-%}

{% capture children %}
  <div class="grip-story grip-story--image-{{ section.settings.image_position }}{% unless show_media %} grip-story--no-image{% endunless %}{% if section.settings.grayscale %} grip-story--grayscale{% endif %}">
    {%- if show_media -%}
      <div class="grip-story__media">
        {%- if has_image -%}
          {% render 'grip-image',
            desktop: section.settings.image,
            mobile: section.settings.image_mobile,
            widths: '416, 600, 800, 1200, 1600, 2000',
            sizes: '(min-width: 750px) 45vw, 100vw'
          %}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'grip-placeholder' }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grip-story__content">
      {%- if section.settings.label != blank -%}
        <p class="grip-label grip-label--muted">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="grip-display h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="grip-story__body">
          {% content_for 'blocks' %}
        </div>
      {%- endif -%}

      {%- if section.settings.attribution != blank -%}
        {%- if section.settings.show_rule -%}
          <hr class="grip-rule grip-story__rule">
        {%- endif -%}
        <p class="grip-label grip-story__attribution">{{ section.settings.attribution | escape }}</p>
      {%- endif -%}
      {%- render 'grip-button',
            label: section.settings.button_label,
            link: section.settings.button_link,
            style: section.settings.button_style,
            arrow: section.settings.button_arrow
          -%}
    </div>
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children, width: 'full' %}

{% stylesheet %}
  .grip-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    @media screen and (min-width: 750px) {
      grid-template-columns: 40% minmax(0, 1fr);
      align-items: stretch;
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: 45% minmax(0, 1fr);
    }
  }

  .grip-story--image-right {
    @media screen and (min-width: 750px) {
      grid-template-columns: minmax(0, 1fr) 40%;

      .grip-story__media {
        order: 2;
      }
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr) 45%;
    }
  }

  .grip-story--no-image {
    grid-template-columns: minmax(0, 1fr);
  }

  .grip-story__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;

    @media screen and (min-width: 750px) {
      aspect-ratio: auto;
      min-height: 100%;
    }

    & .grip-image,
    & .grip-placeholder {
      position: absolute;
      inset: 0;
    }
  }

  .grip-story--grayscale .grip-story__media img {
    filter: grayscale(1);
  }

  .grip-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    min-width: 0;
    padding: var(--grip-gap-xl) var(--page-margin);

    & > * {
      max-width: 35rem;
    }

    @media screen and (min-width: 750px) {
      padding-block: var(--grip-gap-2xl);
      padding-inline: clamp(2rem, 6vw, 7.5rem) var(--page-margin);
    }
  }

  .grip-story--image-right .grip-story__content {
    @media screen and (min-width: 750px) {
      padding-inline: var(--page-margin) clamp(2rem, 6vw, 7.5rem);
    }
  }

  .grip-story--no-image .grip-story__content {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .grip-story__body {
    display: grid;
    gap: 1.25rem;
  }

  .grip-story__rule {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP our story",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "text" }],
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, 4:5. A real photo of the founder is recommended." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional, 4:5. Shown below 750px." },
    { "type": "checkbox", "id": "grayscale", "label": "Black and white", "default": true },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "label", "label": "Label", "default": "OUR STORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BUILT BY A GRAPPLER, FOR GRAPPLERS." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Arturo Salinas, Founder" },
    { "type": "checkbox", "id": "show_rule", "label": "Show rule above attribution", "default": true },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "READ OUR STORY" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The button is hidden until a link is set." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#05070A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8B95A6" },
    { "type": "color", "id": "hairline_color", "label": "Hairlines", "default": "#1D2634" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "presets": [
    {
      "name": "GRIP our story",
      "category": "GRIP",
      "blocks": {
        "p1": {
          "type": "text",
          "settings": { "text": "<p>GRIP started in a gym in Edinburg, Texas — built by people who train, for people who train.</p>", "type_preset": "rte", "width": "100%" }
        },
        "p2": {
          "type": "text",
          "settings": { "text": "<p>Not a hydration brand trying to market to grapplers. GRIP was built from inside the grappling community.</p>", "type_preset": "rte", "width": "100%" }
        },
        "p3": {
          "type": "text",
          "settings": { "text": "<p>Every belt in the system is a stage someone is standing in right now. This is for all of them.</p>", "type_preset": "rte", "width": "100%" }
        }
      },
      "block_order": ["p1", "p2", "p3"]
    }
  ]
}
{% endschema %}
