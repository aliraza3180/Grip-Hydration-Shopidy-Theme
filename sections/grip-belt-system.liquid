{%- liquid
  assign overlay = section.settings.overlay_color
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0

  assign has_image = false
  if section.settings.image_desktop != blank or section.settings.image_mobile != blank
    assign has_image = true
  endif

  assign heading_accent = section.settings.heading_accent
  assign heading_before = section.settings.heading
  assign heading_after = ''
  assign has_accent = false
  if heading_accent != blank and section.settings.heading contains heading_accent
    assign has_accent = true
    assign heading_parts = section.settings.heading | replace_last: heading_accent, '%%grip-accent%%' | split: '%%grip-accent%%'
    assign heading_before = heading_parts.first
    if heading_parts.size > 1
      assign heading_after = heading_parts.last
    endif
  endif

  assign feature_count = 0
  for i in (1..3)
    assign feature_key = 'feature_' | append: i | append: '_title'
    if section.settings[feature_key] != blank
      assign feature_count = feature_count | plus: 1
    endif
  endfor

  assign show_footer = false
  if section.settings.show_features and feature_count > 0
    assign show_footer = true
  endif
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_footer = true
  endif

  capture collection_style
    echo '--grip-overlay-rgb: ' | append: overlay.red | append: ' ' | append: overlay.green | append: ' ' | append: overlay.blue | append: ';'
    echo '--grip-overlay-a: ' | append: overlay_alpha | append: ';'
    echo '--grip-card-bg: ' | append: section.settings.card_background | append: ';'
    echo '--grip-card-border: ' | append: section.settings.card_border | append: ';'
  endcapture
-%}

{% capture children %}
  <div class="grip-collection" style="{{ collection_style | strip_newlines }}">
    {%- if has_image -%}
      <div class="grip-collection__media">
        {% render 'grip-image',
          desktop: section.settings.image_desktop,
          mobile: section.settings.image_mobile,
          widths: '832, 1200, 1600, 1920, 2560',
          decorative: true
        %}
      </div>
      <div class="grip-collection__scrim" aria-hidden="true"></div>
    {%- endif -%}

    <div class="grip-page-grid grip-collection__content">
      <script src="{{ 'grip-belt-rail.js' | asset_url }}" type="module" defer></script>
      <grip-belt-rail class="grip-collection__inner">
        <div class="grip-collection__header">
          <div class="grip-collection__intro">
            {%- if section.settings.label != blank -%}
              <p class="grip-label">{{ section.settings.label | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="grip-display h2 grip-collection__heading">
                {{- heading_before | escape -}}
                {%- if has_accent -%}
                  <span class="grip-collection__accent">{{ heading_accent | escape }}</span>
                  {{- heading_after | escape -}}
                {%- endif -%}
              </h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="grip-collection__sub">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>

          {%- if section.settings.show_arrows and section.blocks.size > 0 -%}
            <div class="grip-collection__arrows">
              <button type="button" class="grip-belt-rail__button" data-direction="-1" aria-label="{{ section.settings.prev_label | escape }}">
                {%- render 'grip-icon', icon: 'arrow-left', size: 18 -%}
              </button>
              <button type="button" class="grip-belt-rail__button" data-direction="1" aria-label="{{ section.settings.next_label | escape }}">
                {%- render 'grip-icon', icon: 'arrow-right', size: 18 -%}
              </button>
            </div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ol
            class="grip-belt-rail__track grip-collection__track"
            role="list"
            tabindex="0"
            aria-label="{{ section.settings.heading | default: section.settings.label | escape }}"
          >
            {% content_for 'blocks' %}
          </ol>
        {%- elsif request.design_mode -%}
          <p class="grip-editor-note">Featured collection: add belt cards.</p>
        {%- endif -%}

        {%- if show_footer -%}
          <div class="grip-collection__footer">
            {%- if section.settings.show_features and feature_count > 0 -%}
              <ul class="grip-collection__features" role="list">
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign icon_key = 'feature_' | append: i | append: '_icon'
                    assign title_key = 'feature_' | append: i | append: '_title'
                    assign text_key = 'feature_' | append: i | append: '_text'
                  -%}
                  {%- if section.settings[title_key] != blank -%}
                    <li class="grip-collection__feature">
                      {%- render 'grip-icon', icon: section.settings[icon_key], size: 30, class: 'grip-collection__feature-icon' -%}
                      <span class="grip-collection__feature-text">
                        <span class="grip-label">{{ section.settings[title_key] | escape }}</span>
                        {%- if section.settings[text_key] != blank -%}
                          <span class="grip-label grip-label--muted">{{ section.settings[text_key] | escape }}</span>
                        {%- endif -%}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- render 'grip-button',
              label: section.settings.button_label,
              link: section.settings.button_link,
              style: section.settings.button_style,
              arrow: section.settings.button_arrow
            -%}
          </div>
        {%- endif -%}
      </grip-belt-rail>
    </div>
  </div>
{% endcapture %}

{% render 'grip-section', section: section, children: children, width: 'full' %}

{% stylesheet %}
  .grip-collection {
    position: relative;
    isolation: isolate;
  }

  .grip-collection__media,
  .grip-collection__scrim {
    position: absolute;
    inset: 0;
  }

  .grip-collection__media {
    z-index: -2;
    overflow: hidden;
  }

  .grip-collection__scrim {
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(var(--grip-overlay-rgb) / calc(var(--grip-overlay-a) * 0.55)) 0%,
      rgb(var(--grip-overlay-rgb) / var(--grip-overlay-a)) 60%
    );
  }

  .grip-collection__inner {
    display: grid;
    gap: 2.5rem;
  }

  .grip-collection__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .grip-collection__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    max-width: 60rem;
  }

  .grip-collection__heading.grip-collection__heading.grip-collection__heading {
    font-size: clamp(2.5rem, 5.4vw, 4.75rem);
    line-height: 0.95;
  }

  .grip-collection__accent {
    color: var(--grip-accent);
  }

  .grip-collection__sub {
    margin: 0;
    font-size: 1.125rem;
  }

  .grip-collection__arrows {
    display: flex;
    gap: 0.75rem;
  }

  .grip-collection .grip-belt-rail__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: inherit;
    background: rgb(var(--color-background-rgb) / 0.6);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: var(--grip-button-radius);
    cursor: pointer;
    transition: border-color var(--animation-speed) var(--animation-timing-hover);

    &:hover:not([disabled]) {
      border-color: var(--color-foreground);
    }

    &[disabled] {
      opacity: 0.35;
      cursor: default;
    }
  }

  .grip-collection__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0 0 0.25rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    & > .grip-belt {
      scroll-snap-align: start;
    }

    @media screen and (max-width: 989px) {
      grid-auto-columns: calc((100% - 1rem) / 2.3);
    }

    @media screen and (max-width: 749px) {
      grid-auto-columns: 78%;
    }
  }

  .grip-collection__track:has(> .grip-belt:nth-child(6)) {
    @media screen and (min-width: 990px) {
      grid-auto-columns: calc((100% - 4rem) / 5);
    }
  }

  .grip-collection__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--color-border);

    & .grip-actions {
      margin: 0;
    }
  }

  .grip-collection__features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 0;
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (max-width: 749px) {
      display: grid;
      gap: 1rem;
    }
  }

  .grip-collection__feature {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline-end: clamp(1.5rem, 3vw, 3.5rem);

    & + & {
      padding-inline-start: clamp(1.5rem, 3vw, 3.5rem);
      border-inline-start: 1px solid var(--color-border);
    }

    @media screen and (max-width: 749px) {
      padding-inline: 0;

      & + & {
        padding-inline-start: 0;
        border-inline-start: 0;
      }
    }
  }

  .grip-collection__feature-icon {
    color: var(--grip-accent);
  }

  .grip-collection__feature-text {
    display: grid;
    gap: 0.125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP featured collection",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "grip-belt" }],
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image_desktop", "label": "Background image", "info": "Optional." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile background image", "info": "Optional. Shown below 750px." },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#05070A" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "label", "label": "Label", "default": "FEATURED COLLECTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "5 BELTS. 5 FLAVORS. ONE MISSION." },
    { "type": "text", "id": "heading_accent", "label": "Accent words", "info": "Must match the end of the heading exactly. Shown in the accent color.", "default": "ONE MISSION." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Different belts. Same commitment. Stay hydrated, keep showing up." },
    { "type": "header", "content": "Cards" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "text", "id": "prev_label", "label": "Previous button label (screen readers)", "default": "Previous belt", "visible_if": "{{ section.settings.show_arrows }}" },
    { "type": "text", "id": "next_label", "label": "Next button label (screen readers)", "default": "Next belt", "visible_if": "{{ section.settings.show_arrows }}" },
    { "type": "text", "id": "status_live_label", "label": "In stock badge", "default": "AVAILABLE NOW" },
    { "type": "text", "id": "status_sold_out_label", "label": "Sold out badge", "default": "SOLD OUT" },
    { "type": "text", "id": "status_soon_label", "label": "Coming soon badge", "default": "COMING SOON" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#0A0E15" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#1D2634" },
    { "type": "header", "content": "Feature strip" },
    { "type": "checkbox", "id": "show_features", "label": "Show feature strip", "default": true },
    {
      "type": "select",
      "id": "feature_1_icon",
      "label": "Feature 1 icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "drop", "label": "Droplet" },
        { "value": "bolt", "label": "Bolt" },
        { "value": "molecule", "label": "Molecule" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "sugar-free", "label": "Sugar-free" },
        { "value": "flame-off", "label": "Zero calories" },
        { "value": "plus-circle", "label": "Plus" },
        { "value": "check", "label": "Check" }
      ],
      "default": "drop"
    },
    { "type": "text", "id": "feature_1_title", "label": "Feature 1 title", "default": "ELECTROLYTES" },
    { "type": "text", "id": "feature_1_text", "label": "Feature 1 text", "default": "1,000MG SODIUM" },
    {
      "type": "select",
      "id": "feature_2_icon",
      "label": "Feature 2 icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "drop", "label": "Droplet" },
        { "value": "bolt", "label": "Bolt" },
        { "value": "molecule", "label": "Molecule" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "sugar-free", "label": "Sugar-free" },
        { "value": "flame-off", "label": "Zero calories" },
        { "value": "plus-circle", "label": "Plus" },
        { "value": "check", "label": "Check" }
      ],
      "default": "bolt"
    },
    { "type": "text", "id": "feature_2_title", "label": "Feature 2 title", "default": "HYDRATION" },
    { "type": "text", "id": "feature_2_text", "label": "Feature 2 text", "default": "ZERO SUGAR" },
    {
      "type": "select",
      "id": "feature_3_icon",
      "label": "Feature 3 icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "drop", "label": "Droplet" },
        { "value": "bolt", "label": "Bolt" },
        { "value": "molecule", "label": "Molecule" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "sugar-free", "label": "Sugar-free" },
        { "value": "flame-off", "label": "Zero calories" },
        { "value": "plus-circle", "label": "Plus" },
        { "value": "check", "label": "Check" }
      ],
      "default": "plus-circle"
    },
    { "type": "text", "id": "feature_3_title", "label": "Feature 3 title", "default": "DISCIPLINE" },
    { "type": "text", "id": "feature_3_text", "label": "Feature 3 text", "default": "SHOWS UP" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "VIEW ALL PRODUCTS" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The button is hidden until a link is set." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary"
    },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#05070A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F4F7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8B95A6" },
    { "type": "color", "id": "hairline_color", "label": "Hairlines", "default": "#1D2634" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    {
      "name": "GRIP featured collection",
      "category": "GRIP",
      "blocks": {
        "white": {
          "type": "grip-belt",
          "settings": { "status": "coming_soon", "belt_name": "WHITE BELT", "flavor": "LEMON LIME", "pack_text": "25 Stick Packs" }
        },
        "blue": {
          "type": "grip-belt",
          "settings": { "status": "live", "belt_name": "BLUE BELT", "flavor": "BLUE RASPBERRY", "title_color": "#3D82FF", "pack_text": "25 Stick Packs" }
        },
        "purple": {
          "type": "grip-belt",
          "settings": { "status": "coming_soon", "belt_name": "PURPLE BELT", "flavor": "GRAPE", "title_color": "#A07CF0", "pack_text": "25 Stick Packs" }
        },
        "brown": {
          "type": "grip-belt",
          "settings": { "status": "coming_soon", "belt_name": "BROWN BELT", "flavor": "TROPICAL PUNCH", "pack_text": "25 Stick Packs" }
        },
        "black": {
          "type": "grip-belt",
          "settings": { "status": "coming_soon", "belt_name": "BLACK BELT", "flavor": "BLACK CHERRY", "pack_text": "25 Stick Packs" }
        }
      },
      "block_order": ["white", "blue", "purple", "brown", "black"]
    }
  ]
}
{% endschema %}
