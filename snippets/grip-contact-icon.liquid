{%- doc -%}
  Contact page icons drawn on the same 24px grid, 1.5px square-capped stroke
  as grip-icon: mail, phone, map-pin, message and clock. Any other name is
  passed through to the grip-icon snippet. Renders nothing for 'none' or blank.

  @param {string} icon - mail | phone | map-pin | message | clock, or any grip-icon name
  @param {number} [size] - Rendered width and height in px, default 24
  @param {string} [class] - Extra class names

  @example
  {% render 'grip-contact-icon', icon: 'mail', size: 22 %}
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 24
  assign own_icons = 'mail,phone,map-pin,message,clock' | split: ','
-%}

{%- if icon != blank and icon != 'none' -%}
  {%- if own_icons contains icon -%}
    <svg
      class="grip-icon grip-icon--{{ icon }} {{ class }}"
      width="{{ icon_size }}"
      height="{{ icon_size }}"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="square"
      stroke-linejoin="miter"
      aria-hidden="true"
      focusable="false"
    >
      {%- case icon -%}
        {%- when 'mail' -%}
          <path d="M3.5 5.5h17v13h-17z"/><path d="M3.5 6.5 12 13l8.5-6.5"/>
        {%- when 'phone' -%}
          <path d="M5.5 3.5h3l1.5 4.5-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2 4.5 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"/>
        {%- when 'map-pin' -%}
          <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>
        {%- when 'message' -%}
          <path d="M3.5 4.5h17v12h-9l-5 4v-4h-3z"/>
        {%- when 'clock' -%}
          <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- endcase -%}
    </svg>
  {%- else -%}
    {%- render 'grip-icon', icon: icon, size: icon_size, class: class -%}
  {%- endif -%}
{%- endif -%}
