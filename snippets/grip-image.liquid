{%- doc -%}
  Renders a responsive, art-directed GRIP image. When both a desktop and a
  mobile image are set, a <source> swaps to the mobile image below 750px.
  When only one is set, it is used at every width. Renders nothing when both
  are blank. The object-position follows each image's focal point.

  @param {image} [desktop] - Image used at 750px and wider (or everywhere when no mobile image)
  @param {image} [mobile] - Image used below 750px
  @param {string} [widths] - Desktop srcset widths, default '832, 1200, 1600, 1920, 2560, 3840'
  @param {string} [mobile_widths] - Mobile srcset widths, default '416, 600, 800, 1200, 1600'
  @param {string} [sizes] - Desktop sizes attribute, default '100vw'
  @param {string} [sizes_mobile] - Mobile sizes attribute, default '100vw'
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [fetchpriority] - 'high', 'low' or 'auto' (default)
  @param {string} [class] - Extra class on the <picture> element
  @param {boolean} [decorative] - Render an empty alt attribute
  @param {string} [alt] - Fallback alt text when the image has none

  @example
  {% render 'grip-image', desktop: section.settings.image_desktop, mobile: section.settings.image_mobile, loading: 'eager', fetchpriority: 'high' %}
{%- enddoc -%}

{%- liquid
  assign primary = desktop
  if primary == blank
    assign primary = mobile
  endif

  assign d_widths = widths | default: '832, 1200, 1600, 1920, 2560, 3840'
  assign m_widths = mobile_widths | default: '416, 600, 800, 1200, 1600'
  assign d_sizes = sizes | default: '100vw'
  assign m_sizes = sizes_mobile | default: '100vw'
  assign img_loading = loading | default: 'lazy'
  assign img_priority = fetchpriority | default: 'auto'

  assign img_alt = primary.alt | default: alt | escape
  if decorative
    assign img_alt = ''
  endif

  assign use_source = false
  if desktop != blank and mobile != blank
    assign use_source = true
  endif

  assign fp_desktop = primary.presentation.focal_point | default: 'center'
  assign fp_mobile = fp_desktop
  if use_source
    assign fp_mobile = mobile.presentation.focal_point | default: 'center'
  endif
  assign img_style = '--grip-fp-d: ' | append: fp_desktop | append: '; --grip-fp-m: ' | append: fp_mobile | append: ';'
-%}

{%- if primary != blank -%}
  <picture class="grip-image {{ class }}">
    {%- if use_source -%}
      {%- assign m_list = m_widths | split: ',' -%}
      <source
        media="(max-width: 749px)"
        srcset="
          {%- for w in m_list -%}
            {%- assign w_clean = w | strip -%}
            {{ mobile | image_url: width: w_clean }} {{ w_clean }}w{% unless forloop.last %}, {% endunless %}
          {%- endfor -%}
        "
        sizes="{{ m_sizes }}"
        width="{{ mobile.width }}"
        height="{{ mobile.height }}"
      >
    {%- endif -%}
    {{
      primary
      | image_url: width: 3840
      | image_tag:
        widths: d_widths,
        sizes: d_sizes,
        loading: img_loading,
        fetchpriority: img_priority,
        alt: img_alt,
        class: 'grip-image__img',
        style: img_style
    }}
  </picture>
{%- endif -%}

{% stylesheet %}
  .grip-image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grip-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--grip-fp-d, center);

    @media screen and (max-width: 749px) {
      object-position: var(--grip-fp-m, var(--grip-fp-d, center));
    }
  }
{% endstylesheet %}
