{%- doc -%}
  One link column in the GRIP footer. Renders nothing on the storefront when
  no menu is assigned or the menu has no links.
{%- enddoc -%}

{% render 'grip-tokens' %}

{%- assign footer_menu = block.settings.menu -%}

{%- if footer_menu != blank and footer_menu.links.size > 0 -%}
  <nav class="grip-footer-menu" aria-labelledby="GripFooterMenu-{{ block.id }}" {{ block.shopify_attributes }}>
    <h2 class="grip-footer-menu__heading grip-label grip-label--muted" id="GripFooterMenu-{{ block.id }}">
      {{- block.settings.heading | default: footer_menu.title | escape -}}
    </h2>
    <ul class="grip-footer-menu__list" role="list">
      {%- for link in footer_menu.links -%}
        <li>
          <a
            class="grip-footer-menu__link"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- elsif request.design_mode -%}
  <p class="grip-editor-note" {{ block.shopify_attributes }}>Footer menu: choose a menu with links. Hidden on the storefront while empty.</p>
{%- endif -%}

{% stylesheet %}
  .grip-footer-menu {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }

  .grip-footer-menu__heading {
    margin: 0;
  }

  .grip-footer-menu__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grip-footer-menu__link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRIP footer menu",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the menu's name.", "default": "SHOP" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ],
  "presets": [
    {
      "name": "GRIP footer menu",
      "category": "GRIP"
    }
  ]
}
{% endschema %}
